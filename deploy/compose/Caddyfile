# Public site address from DOMAIN env.
# Production: DOMAIN=socle.example.com  (automatic HTTPS via Caddy)
# Local / E2E HTTP: DOMAIN=http://127.0.0.1  (disables automatic HTTPS)
# Custom certs: add  tls /certs/fullchain.pem /certs/privkey.pem  inside the site block.
{$DOMAIN:localhost} {
	@api path /api/*
	@actuator path /actuator/*
	@ws path /ws*

	handle @api {
		reverse_proxy backend:8080
	}
	handle @actuator {
		reverse_proxy backend:8080
	}
	handle @ws {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy frontend:8080
	}
}
