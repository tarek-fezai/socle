# Socle production Compose — copy to `.env` and fill every CHANGE_ME_REQUIRED value.
# Do NOT commit `.env`. The backend rejects weak/default secrets (empty, change-me, admin, socle).

# --- Public edge ---
# Hostname served by Caddy (automatic HTTPS when DNS points to this host).
DOMAIN=CHANGE_ME.example.com

# --- Image tags ---
VERSION=latest
# Uncomment to build from source instead of pulling GHCR images:
# COMPOSE_BUILD=1

# --- Postgres (postgres:16-alpine) ---
POSTGRES_USER=socle
# Required — no default in compose. Must not be change-me / admin / socle / empty.
POSTGRES_PASSWORD=CHANGE_ME_REQUIRED

# --- Spring datasource (backend) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/socle_core
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# --- Storage (git = single backend replica; relational allows scale-out) ---
SOCLE_STORAGE_PROVIDER=git
SOCLE_STORAGE_GIT_REPOSITORY_PATH=/data/git-content

# --- OpenFGA (postgres datastore, not memory) ---
OPENFGA_API_URL=http://openfga:8080
# Leave empty — backend auto-init creates store + model (OPENFGA_AUTO_INIT=true).
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
OPENFGA_AUTO_INIT=true
OPENFGA_STATE_DIR=/openfga-config
SOCLE_REJECT_WEAK_SECRETS=true

# --- Temporal ---
TEMPORAL_TARGET=temporal:7233
TEMPORAL_NAMESPACE=default

# --- OIDC (your IdP — not Keycloak unless using demo-idp profile) ---
OIDC_ISSUER_URI=CHANGE_ME_REQUIRED
OIDC_JWK_SET_URI=
OIDC_CLIENT_ID=socle-backend
OIDC_CLIENT_SECRET=CHANGE_ME_REQUIRED
OIDC_FRONTEND_CLIENT_ID=socle-frontend

# --- Instance ---
SOCLE_INSTANCE_DISPLAY_NAME=Socle

# --- CORS (browser origin matching public URL) ---
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.example.com

# --- Webhook worker (same Postgres as backend) ---
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/socle_core?sslmode=disable

# --- DEMO ONLY: Keycloak (Compose profile `demo-idp`) ---
# KEYCLOAK_ADMIN=CHANGE_ME_REQUIRED
# KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_REQUIRED
# KEYCLOAK_HTTP_PORT=8081
# Set OIDC_ISSUER_URI to the URL browsers use to reach Keycloak.
