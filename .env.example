# Postgres
POSTGRES_USER=socle
POSTGRES_PASSWORD=socle
POSTGRES_PORT=5433

# Backend Spring Boot
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/socle_core
SPRING_DATASOURCE_USERNAME=socle
SPRING_DATASOURCE_PASSWORD=socle

OIDC_ISSUER_URI=http://localhost:8081/realms/socle
OIDC_JWK_SET_URI=http://localhost:8081/realms/socle/protocol/openid-connect/certs
OIDC_CLIENT_ID=socle-backend
OIDC_CLIENT_SECRET=change-me

TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=default

OPENFGA_API_URL=http://localhost:8082
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Temporal
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088

# OpenFGA
OPENFGA_HTTP_PORT=8082
OPENFGA_GRPC_PORT=8083
OPENFGA_PLAYGROUND_PORT=3001

# Webhook worker
HTTP_ADDR=:8090
DATABASE_URL=postgres://socle:socle@localhost:5433/socle_core?sslmode=disable
POLL_INTERVAL=3s
BATCH_SIZE=50

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_OIDC_REALM=socle
VITE_OIDC_CLIENT_ID=socle-frontend
VITE_YJS_WS_URL=ws://localhost:1234
