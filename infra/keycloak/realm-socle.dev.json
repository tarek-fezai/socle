{
  "realm": "socle",
  "enabled": true,
  "displayName": "Socle",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "contributeur",
        "description": "Contributeur — création et édition de documents"
      },
      {
        "name": "auditeur",
        "description": "Auditeur — lecture seule du journal d'audit (supervision / conformité)"
      },
      {
        "name": "integrateur",
        "description": "Intégrateur — configuration des connecteurs SIEM et endpoints webhook (séparé de l'audit)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "socle-frontend",
      "name": "Socle Frontend SPA",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "socle-backend",
      "name": "Socle Backend (bearer-only)",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me",
      "bearerOnly": true,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "contributeur",
      "enabled": true,
      "email": "contributeur@example.com",
      "emailVerified": true,
      "firstName": "Camille",
      "lastName": "Contributeur",
      "credentials": [
        {
          "type": "password",
          "value": "contributeur",
          "temporary": false
        }
      ],
      "realmRoles": ["contributeur"]
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "username": "auditeur",
      "enabled": true,
      "email": "auditeur@example.com",
      "emailVerified": true,
      "firstName": "Awa",
      "lastName": "Auditeur",
      "credentials": [
        {
          "type": "password",
          "value": "auditeur",
          "temporary": false
        }
      ],
      "realmRoles": ["auditeur"]
    },
    {
      "id": "55555555-5555-5555-5555-555555555555",
      "username": "integrateur",
      "enabled": true,
      "email": "integrateur@example.com",
      "emailVerified": true,
      "firstName": "Inès",
      "lastName": "Intégrateur",
      "credentials": [
        {
          "type": "password",
          "value": "integrateur",
          "temporary": false
        }
      ],
      "realmRoles": ["integrateur"]
    }
  ]
}
