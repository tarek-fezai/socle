model
  schema 1.1

type user

# Équipes — rôles (docs/teams-and-access.md)
type group
  relations
    define proprietaire: [user]
    define approbateur: [user]
    define contributeur: [user]
    define lecteur: [user]
    define member: proprietaire or approbateur or contributeur or lecteur
    define as_owner: proprietaire
    define as_editor: proprietaire or approbateur or contributeur
    define as_viewer: proprietaire or approbateur or contributeur or lecteur
    define as_approver: proprietaire or approbateur

type organisation
  relations
    define owner: [user, group#member, group#as_owner]
    define editor: [user, group#member, group#as_editor] or owner
    define viewer: [user, group#member, group#as_viewer] or editor

# Cascade organisation → space ; accès direct + groupe + héritage parent
type space
  relations
    define parent: [organisation]
    define owner: [user, group#member, group#as_owner] or owner from parent
    define editor: [user, group#member, group#as_editor] or owner or editor from parent
    define viewer: [user, group#member, group#as_viewer] or editor or viewer from parent

# parent = gouvernance (owner) ; inherit_from = lecture/écriture héritée
type folder
  relations
    define parent: [space, folder]
    define inherit_from: [space, folder]
    define owner: [user, group#member, group#as_owner] or owner from parent
    define editor: [user, group#member, group#as_editor] or owner or editor from inherit_from
    define viewer: [user, user:*, group#member, group#as_viewer] or editor or viewer from inherit_from

# parent = gouvernance (owner from parent)
# inherit_from = editor/viewer hérités (organisation|space ; absent si restricted)
# user:* = viewer public d'instance (organisation)
# direct_access = index ListObjects uniquement — n'accorde AUCUN droit (hors viewer)
type document
  relations
    define parent: [space, folder]
    define inherit_from: [space, folder]
    define direct_access: [user, group#member, group#as_viewer]
    define owner: [user, group#member, group#as_owner] or owner from parent
    define editor: [user, group#member, group#as_editor] or owner or editor from inherit_from
    define viewer: [user, user:*, group#member, group#as_viewer] or editor or viewer from inherit_from
